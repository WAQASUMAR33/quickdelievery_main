  amount         Decimal     @db.Decimal(10, 2)
  initiativeName String      @default("Local Food Bank & Community Essentials") @map("initiative_name") @db.VarChar(255)
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([masterOrderId])
  @@map("community_donations")
}

