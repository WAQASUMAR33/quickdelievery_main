generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  id                 Int       @id @default(autoincrement())
  uid                String    @unique
  username           String
  email              String    @unique
  phoneNumber        String
  role               UserRole  @default(CUSTOMER)
  emailVerification  Boolean   @default(false) @map("email_verification")
  type               String?
  createdAt          DateTime  @default(now()) @map("createdAt")
  updatedAt          DateTime  @updatedAt @map("updatedAt")
  password           String?
  passwordResetToken String?   @map("password_reset_token")
  verificationToken  String?   @map("verification_token")
  image              String?   @map("image") @db.VarChar(500)
  fcmToken           String?   @map("fcm_token") @db.Text
  productsAsApprover Product[] @relation("ApproverProducts")
  productsAsCreator  Product[] @relation("CreatorProducts")
  productsAsVendor   Product[] @relation("VendorProducts")
  orders             Order[]   @relation("CustomerOrders")
  driverOrders       Order[]   @relation("DriverOrders")
  ownedFoodDeals    FoodDeal[] @relation("FoodDealVendorOwner")
  driverProfile      DriverProfile?
  customerProfile    CustomerProfile?
  reviews            Review[]
  wishlists          Wishlist[]
  favorites          Favorite[] @relation("UserFavorites")
  masterOrders       MasterOrder[] @relation("UserMasterOrders")
  wallet             Wallet?
  prescriptions      Prescription[]
  tableBookings      TableBooking[]
  serviceBookings    ServiceBooking[]
  orderDisputes      OrderDispute[]
  priceOffers        PriceOffer[]
  pantrySubscriptions PantrySubscription[]

  @@map("users")
}

model Category {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  description   String?
  status        CategoryStatus @default(ACTIVE)
  vertical      String         @default("FOOD") @map("vertical")
  image         String?        @map("image") @db.VarChar(500)
  createdBy     String         @map("createdBy")
  createdAt     DateTime       @default(now()) @map("createdAt")
  updatedAt     DateTime       @updatedAt @map("updatedAt")
  products          Product[]
  subCategories     SubCategory[]
  productCategories ProductCategory[]
  businesses        Business[]

  @@map("categories")
}

model SubCategory {
  subCatId          Int              @id @default(autoincrement()) @map("sub_cat_id")
  subCatCode        String           @unique @map("sub_cat_code") @db.VarChar(50)
  subCatName        String           @map("sub_cat_name") @db.VarChar(255)
  image             String?          @map("image") @db.VarChar(500)
  status            Boolean          @default(true)
  vertical          String           @default("FOOD") @map("vertical")
  catId             Int?             @map("cat_id")
  productCategoryId Int?             @map("product_category_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  products          Product[]
  category          Category?        @relation(fields: [catId], references: [id], onDelete: Cascade)
  productCategory   ProductCategory? @relation(fields: [productCategoryId], references: [productCategoryId], onDelete: Cascade)

  @@index([catId], map: "sub_categories_cat_id_fkey")
  @@index([productCategoryId], map: "sub_categories_product_category_id_fkey")
  @@map("sub_categories")
}

model ProductCategory {
  productCategoryId          Int              @id @default(autoincrement()) @map("product_category_id")
  productCategoryName        String           @map("product_category_name")
  categoryId                 Int              @map("category_id")
  productCategoryDescription String?          @db.Text @map("product_category_description")
  image                      String?          @map("image") @db.VarChar(500)
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")
  
  category                   Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products                   Product[]
  subCategories              SubCategory[]

  @@index([categoryId], map: "product_categories_category_id_fkey")
  @@map("product_categories")
}

model Product {
  description       String?        @db.Text
  price             Decimal        @db.Decimal(10, 2)
  sku               String         @unique @db.VarChar(100)
  barcode           String?        @unique @db.VarChar(100)
  status            Boolean        @default(true)
  vertical          String         @default("FOOD") @map("vertical")
  approvalStatus    ApprovalStatus @default(Pending) @map("approval_status")
  approveById       String?        @map("approve_by")
  catId             Int         @map("cat_id")
  cost              Decimal        @db.Decimal(10, 2)
  createdAt         DateTime       @default(now()) @map("created_at")
  createdById       String         @map("created_by")
  discount          Decimal        @default(0.00) @db.Decimal(5, 2)
  proId             Int            @id @default(autoincrement()) @map("pro_id")
  proImages         String?        @map("pro_images") @db.LongText
  proName           String         @map("pro_name") @db.VarChar(255)
  qnty              Int            @default(0)
  stock             Int            @default(0)
  subCatId          Int            @map("sub_cat_id")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  vendorId          String         @map("vendor_id")
  brandName         String?        @map("brand_name") @db.VarChar(255)
  conditionType     String?        @map("condition_type") @db.VarChar(50)
  currency          String?        @default("USD") @db.VarChar(10)
  ingredients       String?        @db.Text
  keyFeatures       String?        @map("key_features") @db.LongText
  manufacturer      String?        @db.VarChar(255)
  modelNumber       String?        @map("model_number") @db.VarChar(100)
  packageWeight     String?        @map("package_weight") @db.VarChar(100)
  productDimensions String?        @map("product_dimensions") @db.VarChar(255)
  productType       String?        @map("product_type") @db.VarChar(100)
  reviews           String?        @db.LongText
  saleEndDate       DateTime?      @map("sale_end_date")
  salePrice         Decimal?       @map("sale_price") @db.Decimal(10, 2)
  saleStartDate     DateTime?      @map("sale_start_date")
  sizeName          String?        @map("size_name") @db.VarChar(100)
  variations        String?        @db.LongText
  warranty          String?        @db.VarChar(255)
  color             String?        @db.VarChar(100)
  size              String?        @db.VarChar(100)
  productCategoryId Int?           @map("product_category_id")
  isPrescriptionRequired Boolean   @default(false) @map("is_prescription_required")
  dosageForm        String?        @map("dosage_form") @db.VarChar(100)
  activeIngredients String?        @map("active_ingredients") @db.VarChar(255)
  prepTimeMinutes   Int            @default(20) @map("prep_time_minutes")
  dietaryBadges     String?        @map("dietary_badges") @db.VarChar(255) // HALAL, VEGAN, VEGETARIAN, GLUTEN_FREE, DAIRY_FREE
  allergens         String?        @db.VarChar(255) // Nuts, Dairy, Shellfish, Gluten, Eggs
  modifiersJson     String?        @map("modifiers_json") @db.Text
  fitGuideJson      String?        @map("fit_guide_json") @db.Text
  approver          Users?         @relation("ApproverProducts", fields: [approveById], references: [uid])
  category          Category       @relation(fields: [catId], references: [id], onDelete: Cascade)
  creator           Users          @relation("CreatorProducts", fields: [createdById], references: [uid], onDelete: Cascade)
  subCategory       SubCategory    @relation(fields: [subCatId], references: [subCatId], onDelete: Cascade)
  vendor            Users          @relation("VendorProducts", fields: [vendorId], references: [uid], onDelete: Cascade)
  productCategory   ProductCategory? @relation(fields: [productCategoryId], references: [productCategoryId], onDelete: SetNull)
  orderItems        OrderItem[]
  subOrderItems     SubOrderItem[]
  foodDeal          FoodDeal?
  wishlistedBy      Wishlist[]
  skuVariants       ProductSkuVariant[]
  priceOffers       PriceOffer[]
  pantrySubscriptions PantrySubscription[]

  @@index([approveById], map: "products_approve_by_fkey")
  @@index([catId], map: "products_cat_id_fkey")
  @@index([createdById], map: "products_created_by_fkey")
  @@index([subCatId], map: "products_sub_cat_id_fkey")
  @@index([vendorId], map: "products_vendor_id_fkey")
  @@index([productCategoryId], map: "products_product_category_id_fkey")
  @@map("products")
}

/// Curated storefront deals (Today's Deals carousel). Catalog product and/or custom typed lines (no product row).
model FoodDeal {
  dealId           Int       @id @default(autoincrement()) @map("deal_id")
  productId        Int?      @unique @map("product_id")
  product          Product?  @relation(fields: [productId], references: [proId], onDelete: Cascade)
  vendorUid        String?   @map("vendor_uid") @db.VarChar(128)
  ownerUser        Users?    @relation("FoodDealVendorOwner", fields: [vendorUid], references: [uid], onDelete: SetNull)
  vertical         String    @default("FOOD") @map("vertical")
  customTitle      String?   @map("custom_title") @db.VarChar(255)
  customItemsJson  String?   @map("custom_items_json") @db.Text
  customImageUrl   String?   @map("custom_image_url") @db.VarChar(500)
  customPriceLabel String?   @map("custom_price_label") @db.VarChar(64)
  sortOrder        Int       @default(0) @map("sort_order")
  active           Boolean   @default(true)
  badgeLabel       String?   @map("badge_label") @db.VarChar(64)
  startAt          DateTime? @map("start_at")
  endAt            DateTime? @map("end_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@index([vendorUid])
  @@map("food_deals")
}

model Order {
  id               Int           @id @default(autoincrement())
  userId           Int           @map("user_id")
  driverId         Int?          @map("driver_id")
  status           OrderStatus   @default(PENDING)
  vertical         String        @default("FOOD") @map("vertical")
  shippingAddress  String?       @map("shipping_address") @db.VarChar(500)
  paymentMethod    String?       @map("payment_method") @db.VarChar(50)
  totalAmount      Decimal       @default(0) @map("total_amount") @db.Decimal(10, 2)
  serviceCharge    Decimal       @default(0) @map("service_charge") @db.Decimal(10, 2)
  trackingNumber   String?       @map("tracking_number") @db.VarChar(100)
  deliveryLatitude  Float?       @map("delivery_latitude")
  deliveryLongitude Float?       @map("delivery_longitude")
  estimatedDelivery DateTime?    @map("estimated_delivery")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  user             Users         @relation("CustomerOrders", fields: [userId], references: [id], onDelete: Cascade)
  driver           Users?        @relation("DriverOrders", fields: [driverId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]
  review           Review?

  @@index([userId], map: "orders_user_id_fkey")
  @@index([driverId], map: "orders_driver_id_fkey")
  @@map("orders")
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int      @map("order_id")
  productId  Int      @map("product_id")
  quantity   Int      @default(1)
  price          Decimal  @db.Decimal(10, 2)
  variationJson  String?  @map("variation_json") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [proId], onDelete: Cascade)

  @@index([orderId], map: "order_items_order_id_fkey")
  @@index([productId], map: "order_items_product_id_fkey")
  @@map("order_items")
}

model Business {
  id                  Int              @id @default(autoincrement())
  email               String           @unique @db.VarChar(255)
  businessName        String           @map("business_name") @db.VarChar(255)
  firstName           String           @map("first_name") @db.VarChar(100)
  lastName            String           @map("last_name") @db.VarChar(100)
  cnicNo              String           @map("cnic_no") @db.VarChar(20)
  businessTypeId      Int              @map("business_type_id")
  businessCategoryId  Int              @map("business_category_id")
  phoneNumber1        String           @map("phone_number_1") @db.VarChar(20)
  phoneNumber2        String?          @map("phone_number_2") @db.VarChar(20)
  buildingPlaceName   String?          @map("building_place_name") @db.VarChar(255)
  streetAddress       String           @map("street_address") @db.VarChar(500)
  houseNumber         String?          @map("house_number") @db.VarChar(50)
  state               String           @db.VarChar(100)
  country             String?          @default("Pakistan") @db.VarChar(100)
  city                String           @db.VarChar(100)
  postalCode          String           @map("postal_code") @db.VarChar(20)
  urlCnicFront        String           @map("url_cnic_front") @db.VarChar(500)
  urlCnicBack         String           @map("url_cnic_back") @db.VarChar(500)
  ntnNo               String?          @map("ntn_no") @db.VarChar(50)
  bankName            String           @map("bank_name") @db.VarChar(255)
  bankIbanNo          String           @map("bank_iban_no") @db.VarChar(50)
  bankAccountTitle    String           @map("bank_account_title") @db.VarChar(255)
  billingAddress      String           @map("billing_address") @db.VarChar(500)
  urlLogo             String?          @map("url_logo") @db.VarChar(500)
  urlCoverPhoto       String?          @map("url_cover_photo") @db.VarChar(500)
  urlRestaurantImages String?          @map("url_restaurant_images") @db.LongText
  latitude            Float?           @map("latitude")
  longitude           Float?           @map("longitude")
  vertical            String           @default("FOOD") @map("vertical")
  categoryId          Int?             @map("category_id")
  verificationStatus  BusinessVerificationStatus @default(PENDING) @map("verification_status")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  category            Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  businessType        BusinessType     @relation(fields: [businessTypeId], references: [id])
  businessCategory    BusinessCategory @relation(fields: [businessCategoryId], references: [id])

  @@index([categoryId], map: "businesses_category_id_fkey")
  @@index([businessCategoryId], map: "businesses_business_category_id_fkey")
  @@index([businessTypeId], map: "businesses_business_type_id_fkey")
  @@map("businesses")
}

model BusinessCategory {
  id            Int              @id @default(autoincrement())
  categoryTitle String           @map("category_title") @db.VarChar(255)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  businessTypes BusinessType[]
  businesses    Business[]

  @@map("business_categories")
}

model BusinessType {
  id                 Int               @id @default(autoincrement())
  typeTitle          String            @map("type_title") @db.VarChar(255)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  businessCategoryId Int?              @map("business_category_id")

  businessCategory   BusinessCategory? @relation(fields: [businessCategoryId], references: [id])
  businesses         Business[]

  @@index([businessCategoryId], map: "business_types_business_category_id_fkey")
  @@map("business_types")
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
  DRIVER
  VENDOR
  CUSTOMER
}

enum ApprovalStatus {
  Pending
  Approved
  Rejected
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum BusinessVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Driver-specific profile details (1-to-1 with Users)
model DriverProfile {
  id                    Int        @id @default(autoincrement())
  userId                Int        @unique @map("user_id")
  user                  Users      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── REQUIRED FIELDS ──
  cnicNumber            String     @map("cnic_number") @db.VarChar(20)
  licenseNumber         String     @map("license_number") @db.VarChar(50)
  homeAddress           String     @map("home_address") @db.VarChar(500)
  bankName              String     @map("bank_name") @db.VarChar(150)
  bankAccountTitle      String     @map("bank_account_title") @db.VarChar(200)
  bankAccountNumber     String     @map("bank_account_number") @db.VarChar(50)
  profilePhotoUrl       String     @map("profile_photo_url") @db.VarChar(500)
  equipmentDepositPaid  Boolean    @default(false) @map("equipment_deposit_paid")
  smartphoneCompatible  Boolean    @default(false) @map("smartphone_compatible")

  // ── OPTIONAL FIELDS ──
  vehicleType           String?    @map("vehicle_type") @db.VarChar(50)
  vehicleNumberFrontUrl  String?    @map("vehicle_number_front_url") @db.VarChar(500)
  vehicleRegCertFrontUrl String?    @map("vehicle_reg_cert_front_url") @db.VarChar(500)
  vehicleRegCertBackUrl  String?    @map("vehicle_reg_cert_back_url") @db.VarChar(500)
  cnicFrontUrl           String?    @map("cnic_front_url") @db.VarChar(500)
  cnicBackUrl            String?    @map("cnic_back_url") @db.VarChar(500)
  licenseFrontUrl        String?    @map("license_front_url") @db.VarChar(500)
  licenseBackUrl         String?    @map("license_back_url") @db.VarChar(500)
  emergencyContactName   String?    @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone String?    @map("emergency_contact_phone") @db.VarChar(20)
  preferredZone         String?    @map("preferred_zone") @db.VarChar(150)
  shiftSchedule         String?    @map("shift_schedule") @db.VarChar(100)

  // State
  dutyStatus            DutyStatus @default(OFF_DUTY) @map("duty_status")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  @@map("driver_profiles")
}

model CustomerProfile {
  id          Int      @id @default(autoincrement())
  userId      String   @unique @map("user_id")
  user        Users    @relation(fields: [userId], references: [uid], onDelete: Cascade)
  address     String?  @db.VarChar(255)
  city        String?  @db.VarChar(100)
  state       String?  @db.VarChar(100)
  zipCode     String?  @map("zip_code") @db.VarChar(20)
  dateOfBirth String?  @map("date_of_birth") @db.VarChar(50)
  gender      String?  @db.VarChar(20)
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

enum DutyStatus {
  ON_DUTY
  OFF_DUTY
  ON_DELIVERY
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?  @db.Text
  orderId   Int      @unique @map("order_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reviews")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [proId], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlists")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  vendorUid String   @map("vendor_uid")
  createdAt DateTime @default(now()) @map("created_at")

  user      Users    @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorUid])
  @@index([vendorUid])
  @@map("favorites")
}

model PasswordResetOtp {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  otp       String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_otps")
}

model OrderMessage {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  senderId    Int      @map("sender_id")
  senderRole  String   @map("sender_role") @db.VarChar(50)
  senderName  String?  @map("sender_name") @db.VarChar(150)
  message     String   @db.Text
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([senderId])
  @@map("order_messages")
}

model DriverLocation {
  id        Int      @id @default(autoincrement())
  driverId  Int      @unique @map("driver_id")
  latitude  Float
  longitude Float
  heading   Float?   @default(0)
  speed     Float?   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("driver_locations")
}

// ==========================================
// SUPER APP PHASE 1: SPLIT FULFILLMENT & REWARDS WALLET
// ==========================================

model MasterOrder {
  id                Int                 @id @default(autoincrement())
  masterOrderNumber String              @unique @map("master_order_number") @db.VarChar(100)
  userId            Int                 @map("user_id")
  user              Users               @relation("UserMasterOrders", fields: [userId], references: [id], onDelete: Cascade)
  status            String              @default("PENDING") @db.VarChar(50) // PENDING, PROCESSING, PARTIALLY_COMPLETED, COMPLETED, CANCELLED
  paymentMethod     String              @map("payment_method") @db.VarChar(50)
  paymentStatus     String              @default("PAID") @map("payment_status") @db.VarChar(50)
  totalAmount       Decimal             @map("total_amount") @db.Decimal(10, 2)
  serviceCharge     Decimal             @default(0.00) @map("service_charge") @db.Decimal(10, 2)
  deliveryFee       Decimal             @default(0.00) @map("delivery_fee") @db.Decimal(10, 2)
  discountAmount    Decimal             @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  roundUpDonation   Decimal             @default(0.00) @map("round_up_donation") @db.Decimal(10, 2)
  shippingAddress   String              @map("shipping_address") @db.VarChar(500)
  deliveryLatitude  Float?              @map("delivery_latitude")
  deliveryLongitude Float?              @map("delivery_longitude")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  subOrders         SubOrder[]
  donations         CommunityDonation[]

  @@index([userId])
  @@map("master_orders")
}

model SubOrder {
  id                    Int            @id @default(autoincrement())
  subOrderNumber        String         @unique @map("sub_order_number") @db.VarChar(100)
  masterOrderId         Int            @map("master_order_id")
  masterOrder           MasterOrder    @relation(fields: [masterOrderId], references: [id], onDelete: Cascade)
  vendorId              String         @map("vendor_id") @db.VarChar(128)
  fulfillmentTrack      String         @map("fulfillment_track") @db.VarChar(50) // TRACK_A_HYPERLOCAL_EXPRESS, TRACK_B_SCHEDULED_SLOT, TRACK_C_STANDARD_COURIER
  status                String         @default("PENDING") @db.VarChar(50) // PENDING, ACCEPTED, PREPARING, READY_FOR_DISPATCH, DISPATCHED, DELIVERED, CANCELLED
  driverId              Int?           @map("driver_id")
  subtotal              Decimal        @db.Decimal(10, 2)
  deliveryFee           Decimal        @default(0.00) @map("delivery_fee") @db.Decimal(10, 2)
  scheduledSlotStart    DateTime?      @map("scheduled_slot_start")
  scheduledSlotEnd      DateTime?      @map("scheduled_slot_end")
  slaDeadline           DateTime?      @map("sla_deadline")
  slaCompensated        Boolean        @default(false) @map("sla_compensated")
  onTheWayAddonUntil    DateTime?      @map("on_the_way_addon_until")
  qualityCheckPhotoUrl  String?        @map("quality_check_photo_url") @db.VarChar(500)
  qualityCheckVideoUrl  String?        @map("quality_check_video_url") @db.VarChar(500)
  qualityCheckStatus    String?        @default("PENDING") @map("quality_check_status") @db.VarChar(50) // PENDING, VERIFIED, REJECTED
  trackingNumber        String?        @map("tracking_number") @db.VarChar(100)
  prescriptionId        Int?           @map("prescription_id")
  prescription          Prescription?  @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  isTryAndDecide        Boolean        @default(false) @map("is_try_and_decide")
  tryAndDecideStatus    String?        @default("NONE") @map("try_and_decide_status") @db.VarChar(50) // NONE, PENDING_DECISION, PARTIAL_RETURN, ACCEPTED_ALL, REJECTED_ALL
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  items                 SubOrderItem[]
  serviceBookings       ServiceBooking[]
  disputes              OrderDispute[]

  @@index([masterOrderId])
  @@index([vendorId])
  @@index([driverId])
  @@index([prescriptionId])
  @@map("sub_orders")
}

model SubOrderItem {
  id                      Int           @id @default(autoincrement())
  subOrderId              Int           @map("sub_order_id")
  subOrder                SubOrder      @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  productId               Int           @map("product_id")
  product                 Product       @relation(fields: [productId], references: [proId], onDelete: Cascade)
  productName             String        @map("product_name") @db.VarChar(255)
  quantity                Int           @default(1)
  price                   Decimal       @db.Decimal(10, 2)
  variationJson           String?       @map("variation_json") @db.Text
  vertical                String        @default("FOOD") @db.VarChar(50) // FOOD, GROCERY, PHARMACY, FASHION, ELECTRONICS, SERVICES
  isOnTheWayAddon         Boolean       @default(false) @map("is_on_the_way_addon")
  prescriptionId          Int?          @map("prescription_id")
  prescription            Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  modifierSelectionsJson  String?       @map("modifier_selections_json") @db.Text
  cookingInstructions     String?       @map("cooking_instructions") @db.Text
  selectedSize            String?       @map("selected_size") @db.VarChar(50)
  selectedColor           String?       @map("selected_color") @db.VarChar(50)
  isTryAndDecideVariant   Boolean       @default(false) @map("is_try_and_decide_variant")
  decisionStatus          String?       @default("PENDING") @map("decision_status") @db.VarChar(50) // PENDING, KEPT, RETURNED_TO_RIDER
  createdAt               DateTime      @default(now()) @map("created_at")

  @@index([subOrderId])
  @@index([productId])
  @@index([prescriptionId])
  @@map("sub_order_items")
}

model Wallet {
  id            Int                 @id @default(autoincrement())
  userId        Int                 @unique @map("user_id")
  user          Users               @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Decimal             @default(0.00) @db.Decimal(10, 2) // Immediately spendable
  escrowBalance Decimal             @default(0.00) @map("escrow_balance") @db.Decimal(10, 2) // Pending return window clearance
  currency      String              @default("USD") @db.VarChar(10)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  transactions  WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            Int       @id @default(autoincrement())
  walletId      Int       @map("wallet_id")
  wallet        Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          String    @db.VarChar(20) // DEBIT, CREDIT
  category      String    @db.VarChar(50) // CASHBACK, PURCHASE, SLA_COMPENSATION, REFUND, ROUNDUP_DONATION, ESCROW_HOLD, ESCROW_RELEASE
  amount        Decimal   @db.Decimal(10, 2)
  balanceAfter  Decimal   @map("balance_after") @db.Decimal(10, 2)
  status        String    @default("COMPLETED") @db.VarChar(30) // COMPLETED, PENDING_CLEARANCE, REVERSED
  clearanceAt   DateTime? @map("clearance_at")
  referenceType String?   @map("reference_type") @db.VarChar(50) // MASTER_ORDER, SUB_ORDER, SLA_BREACH
  referenceId   String?   @map("reference_id") @db.VarChar(100)
  description   String?   @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([walletId])
  @@map("wallet_transactions")
}

model CommunityDonation {
  id             Int         @id @default(autoincrement())
